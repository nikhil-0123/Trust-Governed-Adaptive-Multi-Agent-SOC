# Ubuntu Telemetry Endpoint Configuration
APP_NAME="TGAM-SOC Ubuntu Telemetry"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Collector Configuration
AUTH_LOG_PATH=/var/log/auth.log
UBUNTU_EVENT_BATCH_SIZE=100
UBUNTU_EVENT_POLL_INTERVAL_SECONDS=5

# Central SOC API Transport
SOC_API_URL=http://127.0.0.1:8000/api/v1/detection-events
SOC_API_TOKEN=dev-token-123

# Filtering & Sensitivity
MEDIUM_CONFIDENCE_THRESHOLD=0.8
