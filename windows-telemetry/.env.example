# TGAM-SOC Windows Telemetry Endpoint Configuration
APP_NAME="TGAM-SOC Windows Telemetry"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Collector settings
WINDOWS_SECURITY_LOG_NAME="Security"
WINDOWS_EVENT_BATCH_SIZE="100"
WINDOWS_EVENT_POLL_INTERVAL_SECONDS="5"
WINDOWS_INITIAL_LOOKBACK_MINUTES="10"

# Detection State Management (Phase 1)
WINDOWS_DETECTION_MAX_STATE_KEYS=10000
WINDOWS_DETECTION_CLEANUP_INTERVAL_SECONDS=5.0

# Central SOC Transport (Set to Central Server IP for multi-laptop deployment)
SOC_API_URL=http://127.0.0.1:8000/api/v1/detection-events
SOC_API_TOKEN=dev-token-123

# Dedicated Per-Agent Transition Authentication Token (WP-1E)
# Must be unique per agent and distinct from the shared SOC_API_TOKEN
# Used for authenticated epoch governance at POST /api/v1/events/transition
SOC_AGENT_API_TOKEN=dev-agent-token-win01

# Server-side companion mapping (required for transition authentication):
# SOC_AGENT_API_TOKENS={"AGT-WIN-01":"dev-agent-token-win01"}

# Outbox Storage & WAL Configuration (WP-2-D)
# OUTBOX_SYNCHRONOUS_MODE="NORMAL"   # Allowed: NORMAL, FULL
# OUTBOX_BUSY_TIMEOUT_MS=5000         # Min: 1000 ms
# OUTBOX_WAL_AUTOCHECKPOINT=1000      # Min: 10 pages

# State and Data directories (Optional overrides)
# DATA_DIR="C:\ProgramData\TGAM-SOC\Telemetry"
# WINDOWS_CHECKPOINT_DIR="C:\ProgramData\TGAM-SOC\Telemetry\state"
