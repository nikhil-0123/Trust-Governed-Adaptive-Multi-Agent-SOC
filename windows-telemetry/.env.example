# TGAM-SOC Windows Telemetry Endpoint Configuration
APP_NAME="TGAM-SOC Windows Telemetry"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Collector settings
WINDOWS_SECURITY_LOG_NAME="Security"
WINDOWS_EVENT_BATCH_SIZE="100"
WINDOWS_EVENT_POLL_INTERVAL_SECONDS="5"
WINDOWS_INITIAL_LOOKBACK_MINUTES="10"

# Central SOC Transport (Set to Central Server IP for multi-laptop deployment)
SOC_API_URL=http://127.0.0.1:8000/api/v1/detection-events
SOC_API_TOKEN=dev-token-123

# State and Data directories (Optional overrides)
# DATA_DIR="C:\ProgramData\TGAM-SOC\Telemetry"
# WINDOWS_CHECKPOINT_DIR="C:\ProgramData\TGAM-SOC\Telemetry\state"

