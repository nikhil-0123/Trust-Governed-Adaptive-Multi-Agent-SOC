{
  "contract": "normalized_security_event",
  "version": "1.0",
  "required": [
    "event_id",
    "timestamp",
    "agent_id",
    "hostname",
    "os",
    "event_type",
    "source_ip",
    "username",
    "severity",
    "detection_type",
    "confidence",
    "evidence"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "source_ip": {
      "type": ["string", "null"]
    },
    "username": {
      "type": ["string", "null"]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "detection_type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence": {
      "type": "object"
    }
  }
}
